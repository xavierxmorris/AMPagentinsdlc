---
import Layout from '../layouts/Layout.astro';
import GameList from '../components/GameList.svelte';
import "../styles/global.css";
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">

    <!-- Hero Section -->
    <div class="relative mb-16 py-14 px-8 rounded-2xl bg-gradient-to-br from-slate-800/80 via-slate-800/60 to-slate-900/80 border border-slate-700/50 overflow-hidden">
      <!-- Decorative blobs -->
      <div class="absolute top-0 right-0 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3 pointer-events-none"></div>
      <div class="absolute bottom-0 left-1/3 w-64 h-64 bg-purple-600/10 rounded-full blur-3xl translate-y-1/2 pointer-events-none"></div>

      <div class="relative z-10 max-w-2xl">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-400 text-sm font-medium mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
          </svg>
          Developer-Themed Tabletop Games
        </div>

        <!-- Heading -->
        <h2 class="text-5xl font-bold mb-5 leading-tight">
          <span class="text-slate-100">Back the games </span>
          <span class="bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">you love</span>
        </h2>

        <!-- Tagline paragraph — kept for e2e tests -->
        <p class="text-xl text-slate-300 mb-8 leading-relaxed max-w-xl">Find your next game! And maybe even back one! Explore our collection!</p>

        <!-- CTA buttons -->
        <div class="flex flex-wrap gap-4">
          <a
            href="#games"
            class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 text-white rounded-xl font-semibold transition-all duration-200 shadow-lg shadow-blue-500/20 hover:shadow-blue-500/35 hover:-translate-y-px"
          >
            Explore Games
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 10.293a1 1 0 010 1.414l-6 6a1 1 0 01-1.414 0l-6-6a1 1 0 111.414-1.414L9 14.586V3a1 1 0 012 0v11.586l4.293-4.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
          </a>
          <a href="/about" class="px-6 py-3 bg-slate-700/50 hover:bg-slate-700/80 text-slate-200 rounded-xl font-semibold transition-all duration-200 border border-slate-600/50 hover:border-slate-500/70">
            Learn More
          </a>
        </div>
      </div>
    </div>

    <!-- Games Section -->
    <div id="games">
      <GameList client:only="svelte" />
    </div>

  </div>
</Layout>
